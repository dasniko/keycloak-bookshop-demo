{
	"name": "Keycloak Bookshop Demo",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"forwardPorts": [8080, 8081, 3000, 8083],
	"portsAttributes": {
		"8080": { "label": "Keycloak" },
		"8081": { "label": "Shop", "onAutoForward": "openBrowser" },
		"3000": { "label": "Checkout" },
		"8083": { "label": "Cart" }
	},
	"postStartCommand": "bash .devcontainer/start.sh"
}
